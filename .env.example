# Copy this file to .env and fill in secrets before docker compose up.
#   cp .env.example .env
# Compose interpolates these into redis, minio, and the app services.
# Do not commit .env.

# Web login (config.ini [basic] visionai_secret is also accepted)
VISIONAI_SECRET=

# Flask session signing key; leave empty to derive from VISIONAI_SECRET
VISIONAI_SESSION_SECRET=

# Redis requirepass (must match config.ini [redis] password when using start.sh)
REDIS_PASSWORD=

# MinIO root account (app S3 keys should match)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# Must match config/zlm/config.ini [api] secret.
# The value in that ini is a PUBLIC demo; rotate both files in production.
ZLM_SECRET=

# Optional
# VISIONAI_TIMEZONE=Asia/Shanghai
# INFERENCE_DEVICE=cpu
# VISIONAI_ALLOW_PROCESS_RESTART=0
